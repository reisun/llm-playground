# Web UI port (default: 3000)
WEBUI_PORT=3000

# Claude setup-token OAuth token (run `claude setup-token` to obtain)
# When set, this takes priority over host-mounted ~/.claude auth.
CLAUDE_SETUP_TOKEN=
# Token expiration date in YYYY-MM-DD format (setup-token tokens are valid for ~1 year)
CLAUDE_TOKEN_EXPIRES_AT=
